package com.klef.soa.docker.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.klef.soa.docker.entity.VideoEditingJobEntity;
import com.klef.soa.docker.repository.VideoEditingJobRepository;

@Service
public class VideoEditingJobServiceImpl implements VideoEditingJobService
{
    @Autowired
    private VideoEditingJobRepository repo;

    @Override
    public VideoEditingJobEntity addVideoEditingJob(VideoEditingJobEntity videoEditingJob)
    {
        videoEditingJob.setId(null);
        return repo.save(videoEditingJob);
    }

    @Override
    public List<VideoEditingJobEntity> displayAllVideoEditingJobs()
    {
        return repo.findAll();
    }

    @Override
    public VideoEditingJobEntity updateVideoEditingJob(VideoEditingJobEntity v)
    {
        Optional<VideoEditingJobEntity> optional = repo.findById(v.getId());

        if(optional.isPresent())
        {
            VideoEditingJobEntity videoEditingJob = optional.get();

            videoEditingJob.setClientName(v.getClientName());
            videoEditingJob.setVideoType(v.getVideoType());
            videoEditingJob.setFee(v.getFee());
            videoEditingJob.setCompleted(v.isCompleted());

            return repo.save(videoEditingJob);
        }
        else
        {
            return null;
        }
    }

    @Override
    public VideoEditingJobEntity displayVideoEditingJobById(Long id)
    {
        return repo.findById(id).orElse(null);
    }

    @Override
    public String deleteVideoEditingJobById(Long id)
    {
        boolean status = repo.existsById(id);

        if(status)
        {
            repo.deleteById(id);
            return "Video Editing Job Deleted Successfully";
        }
        else
        {
            return "Video Editing Job ID Not Found";
        }
    }

    @Override
    public List<VideoEditingJobEntity> displayCompletedJobs()
    {
        return repo.findByCompleted(true);
    }

    @Override
    public List<VideoEditingJobEntity> displayNonCompletedJobs()
    {
        return repo.findByCompleted(false);
    }

    @Override
    public List<VideoEditingJobEntity> displayJobsByVideoType(String videoType)
    {
        return repo.findByVideoType(videoType);
    }
}